---
import Layout from "../layouts/main.astro";
import {DISCORD} from "../config";
import Timer from "../components/Timer.astro";
import SimpleCard from "../components/SimpleCard.astro"
---

<Layout title="SpookyJam" description="SpookyJam is an annual mod jam held in celebration of the fall season!" displayTitle = {false}>
    <img class="mx-auto w-3/4" src="./hero_image.png"/>
    <p class="text-center">
        SpookyJam is an annual Minecraft mod jam held in celebration of the fall season! We invite modders of all skill
        levels to join us in creating mods that are spooky, mysterious, or fit with the vibes of autumn. Our goal is to
        foster a sense of community and encourage everyone to push their creative limits!
    </p>

    <h2 class="text-center" id="next-event">SpookyJam 2026</h2>
    <Timer date={Date.UTC(2026, 8, 26, 0, 0, 0)}>
        <div slot="before">
            <p class="text-center">
                SpookyJam 2026 will begin on September 18th! We look forward to celebrating with the community and hope
                you will join us!
            </p>
            <p class="text-center">
                You can learn more about the event <a href="/events/2026">here</a>.
            </p>
        </div>
        <div slot="after">
            <p class="text-center">
                SpookyJam 2026 has officially started! You may now start working on your entries! You will have until
                October 25th to submit your entry. We recommend submitting your entry as soon as possible so players
                have time to enjoy your mod throughout the month!
            </p>
            <img class="mx-auto my-8" width="64" src="/ghost_logo.png" alt="Lumina, the mascot of SpookyJam!"/>
        </div>
    </Timer>
    
    <div class="grid gap-10 md:grid-cols-2 w-10/12 my-16 mx-auto">
        <SimpleCard title="Celebrate the Season" icon="🎃" summary="Embrace the spirit of fall with fellow creators in a community full of chills, thrills, and creativity."/>
        <SimpleCard title="Win Unique Prizes" icon="🍬" summary="Earn unique and exclusive rewards for showing off your spooky skills!"/>
        <SimpleCard title="Make New Friends" icon="👻" summary="Connect with modders, artists, and players who share your love for the strange and eerie!"/>
        <SimpleCard title="Level Up" icon="👾" summary="Improve your coding, art, and design skills in a supportive and festive environment!"/>
        <div class="col-span-2 justify-self-center" >
            <SimpleCard title="Play" icon="🎭" summary="Download the modpack and check out the public server!"/>
        </div>
    </div>
</Layout>